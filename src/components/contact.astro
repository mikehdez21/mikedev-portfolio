---
import '@styles/components/contact.css';
import '@styles/components/light-styles/contact-light.css';
import Text from '@/components/i18n/Text.astro';
---

<section id="contacto" class="contact-section" aria-labelledby="contact-title">
	<h1 id="contact-title">
		<button class="section-toggle" type="button" data-section-toggle aria-expanded="true" aria-controls="contact-content">
			<span class="online-dot" aria-hidden="true"></span>
			<Text path="contact.title" />
		</button>
	</h1>

	<div id="contact-content">
		<form class="contact-form" data-contact-form>
			<div class="contact-field">
				<label for="contact-email"><Text path="contact.emailLabel" /></label>
				<input
					id="contact-email"
					name="email"
					type="email"
					inputmode="email"
					autocomplete="email"
					placeholder="you@email.com"
					data-i18n-placeholder="contact.emailPlaceholder"
					maxlength="254"
					required
				/>
			</div>

			<div class="contact-field">
				<label for="contact-subject"><Text path="contact.subjectLabel" /></label>
				<input
					id="contact-subject"
					name="subject"
					type="text"
					placeholder="What do you want to write about?"
					data-i18n-placeholder="contact.subjectPlaceholder"
					minlength="3"
					maxlength="140"
					required
				/>
			</div>

			<div class="contact-field">
				<label for="contact-message"><Text path="contact.messageLabel" /></label>
				<textarea
					id="contact-message"
					name="message"
					rows="6"
					placeholder="Tell me about your need, a project, a question…"
					data-i18n-placeholder="contact.messagePlaceholder"
					minlength="10"
					maxlength="4000"
					required
				></textarea>
			</div>

			<div class="contact-honeypot" aria-hidden="true">
				<label for="contact-botcheck"><Text path="contact.honeypot" /></label>
				<input
					id="contact-botcheck"
					name="botcheck"
					type="text"
					tabindex="-1"
					autocomplete="off"
					data-contact-honeypot
				/>
			</div>

			<p class="contact-status" data-contact-status role="status" aria-live="polite"></p>

			<button class="contact-submit" type="submit" data-contact-submit>
				<span data-contact-submit-label data-i18n-path="contact.submit">Send message</span>
			</button>
		</form>
	</div>
</section>
