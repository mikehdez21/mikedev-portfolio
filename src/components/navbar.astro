---
import '@styles/components/navbar.css';
import '@styles/components/light-styles/navbar-light.css';
---

<nav>
    <div class="navMenu">

        <span class="terminal-line" aria-hidden="true"></span>
        <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-navigation">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
        </button>

        <svg class="terminal-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="m7 9 3 3-3 3m5 0h4" />
        </svg>

        <a href="#inicio" aria-label="Volver al inicio">Miguel Angel Rendon Hernandez</a>
        <ul id="primary-navigation">
            <li><a href="#acerca">Acerca</a></li>
            <li><a href="#experiencia">Experiencia</a></li>
            <li><a href="#proyectos">Proyectos</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#contacto">Contacto</a></li>
        </ul>

        <div class="nav-controls">

            <button class="mode-toggle" type="button" aria-label="Cambiar a modo claro">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <g class="theme-moon">
                        <path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" />
                    </g>
                    <g class="theme-sun">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" />
                    </g>
                </svg>
            </button>

            <button class="language-toggle" type="button" aria-label="Cambiar idioma, actualmente español">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3c2.2 2.4 3.3 5.4 3.3 9s-1.1 6.6-3.3 9c-2.2-2.4-3.3-5.4-3.3-9S9.8 5.4 12 3Z" />
                </svg>
                <span>ES</span>
            </button>
            
        </div>
    </div>
</nav>