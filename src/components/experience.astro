---
import '@styles/components/experience.css';
import '@styles/components/light-styles/experience-light.css';
import Text from '@/components/i18n/Text.astro';
import ListItem from '@/components/i18n/ListItem.astro';
import { tList } from '@/i18n';
---

<section id="experiencia" class="experience-section" aria-labelledby="experience-title">
	<h1 id="experience-title">
		<button class="section-toggle" type="button" data-section-toggle aria-expanded="true" aria-controls="experience-timeline">
			<span class="online-dot" aria-hidden="true"></span>
			<Text path="experience.title" />
		</button>
	</h1>

	<div id="experience-timeline" class="experience-timeline">
		<article class="experience-entry">
			<svg class="experience-marker" viewBox="0 0 20 20" aria-hidden="true">
				<circle cx="10" cy="10" r="6" />
			</svg>

			<section id="exp_HospitalSanSerafin" class="experience-content" aria-labelledby="exp-hospital-title">
				<p class="experience-date">
					<Text path="experience.date" tag="span" />
					<span class="experience-date-connector" aria-hidden="true"></span>
				</p>
				<p class="experience-company"><Text path="experience.company" /></p>

				<h2 id="exp-hospital-title"><Text path="experience.role" /></h2>
				<p class="experience-summary"><Text path="experience.summary" /></p>
				<ul>
					<li>
						<Text path="experience.implementationsIntro" />
						<ul class="experience-sublist">
							{tList('experience.implementations', undefined, 'en').map((_, index) => (
								<li><ListItem path="experience.implementations" index={index} /></li>
							))}
						</ul>
					</li>
					{tList('experience.bullets', undefined, 'en').map((_, index) => (
						<li><ListItem path="experience.bullets" index={index} /></li>
					))}
				</ul>
			</section>
		</article>
	</div>
</section>
