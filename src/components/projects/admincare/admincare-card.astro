---
// Datos de AdminCare. Las capturas viven en `public/images/projects/admincare/`.
// Para agregar o quitar capturas, edita el arreglo `images` (en orden de archivo 01 → 16).

interface ProjectImage {
	src: string;
	alt: string;
}

interface Project {
	title: string;
	images: ProjectImage[];
	technologies: string[];
	description: string;
	githubUrl: string;
	demoUrl: string;
}

const project: Project = {
	title: 'AdminCare',
	images: [
		{ src: '/images/projects/admincare/01-Login.webp', alt: 'Pantalla de inicio de sesión de AdminCare' },
		{ src: '/images/projects/admincare/02-Home-AlmacenGeneral.webp', alt: 'Página principal del almacén general en AdminCare' },
		{ src: '/images/projects/admincare/03-Facturas-AlmacenGeneral.webp', alt: 'Listado de facturas del almacén general en AdminCare' },
		{ src: '/images/projects/admincare/04-Filters-AFs.webp', alt: 'Filtros de búsqueda de activos fijos en AdminCare' },
		{ src: '/images/projects/admincare/05-Showing-AFs.webp', alt: 'Listado de activos fijos en AdminCare' },
		{ src: '/images/projects/admincare/06-Movimientos-AF.webp', alt: 'Historial de movimientos de un activo fijo en AdminCare' },
		{ src: '/images/projects/admincare/07-Etiquetas-AF.webp', alt: 'Etiquetas asociadas a un activo fijo en AdminCare' },
		{ src: '/images/projects/admincare/08-ShowingEtiqueta-AF.webp', alt: 'Detalle de una etiqueta de activo fijo en AdminCare' },
		{ src: '/images/projects/admincare/09-InfoQR-AF.webp', alt: 'Código QR de un activo fijo en AdminCare' },
		{ src: '/images/projects/admincare/10-Suppliers-AF.webp', alt: 'Listado de proveedores de activos fijos en AdminCare' },
		{ src: '/images/projects/admincare/11-AdminHome.webp', alt: 'Panel de administración de AdminCare' },
		{ src: '/images/projects/admincare/12-Users.webp', alt: 'Gestión de usuarios en AdminCare' },
		{ src: '/images/projects/admincare/13-Employeers.webp', alt: 'Gestión de empleados en AdminCare' },
		{ src: '/images/projects/admincare/14-Departments.webp', alt: 'Gestión de departamentos en AdminCare' },
		{ src: '/images/projects/admincare/15-Locations.webp', alt: 'Gestión de ubicaciones en AdminCare' },
		{ src: '/images/projects/admincare/16-RBAC.webp', alt: 'Gestión de roles y permisos (RBAC) en AdminCare' },
	],
	technologies: ['React', 'TypeScript', 'PHP-Laravel', 'PostgreSQL (SQLite DEMO)'], // placeholder: reemplaza con las tecnologías reales
	description:
		'AdminCare comenzó como un sistema para almacén general y control de activos, pero el desarrollo fue ampliando su alcance hasta convertirlo en una base tipo ERP pensada para crecer por microsistemas. Hoy sigue cubriendo almacén y activos, etiquetado de instrumental de CEYE, helpdesk, intranet hospitalaria.',
	githubUrl: 'https://github.com/mikehdez21/AdminCare', // placeholder: URL real del repositorio en GitHub
	demoUrl: 'https://admincare-demo.onrender.com/login', // placeholder: URL real de la demo en vivo
};
---

<li>
	<article class="project-card">
		{project.images.length > 0 && (
			<div class="project-card-media-wrap">
				<div
					class="project-card-media"
					data-gallery={project.images.length > 1 ? '' : undefined}
					role={project.images.length > 1 ? 'group' : undefined}
					tabindex={project.images.length > 1 ? 0 : undefined}
					aria-label={project.images.length > 1 ? `Galería de ${project.images.length} capturas de ${project.title}` : undefined}
				>
					{project.images.map((image) => (
						<div class="project-card-slide">
							<img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
						</div>
					))}
				</div>
				{project.images.length > 1 && (
					<>
						<span class="project-card-counter" data-gallery-counter aria-hidden="true">1/{project.images.length}</span>
						<button
							type="button"
							class="project-card-expand"
							data-gallery-expand
							aria-label={`Ver ${project.title} en grande`}
						>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d="M8 3H5a2 2 0 0 0-2 2v3" />
								<path d="M16 3h3a2 2 0 0 1 2 2v3" />
								<path d="M16 21h3a2 2 0 0 0 2-2v-3" />
								<path d="M8 21H5a2 2 0 0 1-2-2v-3" />
							</svg>
						</button>
						<button
							type="button"
							class="project-card-arrow"
							data-gallery-prev
							aria-label={`Imagen anterior de ${project.title}`}
						>
							<span aria-hidden="true">←</span>
						</button>
						<button
							type="button"
							class="project-card-arrow"
							data-gallery-next
							aria-label={`Imagen siguiente de ${project.title}`}
						>
							<span aria-hidden="true">→</span>
						</button>
					</>
				)}
			</div>
		)}
		<div class="project-card-body">
			<h3 class="project-card-title">{project.title}</h3>
			<ul class="project-card-tech">
				{project.technologies.map((tech) => (
					<li class="project-card-tag">{tech}</li>
				))}
			</ul>
			<p class="project-card-description">{project.description}</p>
			<div class="project-card-actions">
				<a
					class="project-link"
					href={project.githubUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Ver el código de ${project.title} en GitHub`}
				>
					Código
				</a>
				<a
					class="project-link"
					href={project.demoUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`Ver la demo en vivo de ${project.title}`}
				>
					Demo
				</a>
			</div>
		</div>
	</article>
</li>
