---
import '@styles/components/projects.css';
import AdminCareCard from '@/components/projects/admincare/admincare-card.astro';
---

<section id="proyectos" aria-labelledby="projects-title">
	<h1 id="projects-title">
		<button class="section-toggle" type="button" data-section-toggle aria-label="Contraer proyectos" aria-expanded="true" aria-controls="projects-content">
			<span class="online-dot" aria-hidden="true"></span>
			<span>Proyectos</span>
		</button>
    </h1>
	<div id="projects-content">
		<!-- Cada proyecto es un componente propio en src/components/projects/<proyecto>/.
		     Los href="#" son placeholders documentados: no navegan hasta que pongas las URLs reales
		     en los archivos de cada proyecto. -->
		<ul class="projects-grid">
			<AdminCareCard />
		</ul>
	</div>
</section>
