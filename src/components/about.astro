---
import '@styles/components/about.css';
import Text from '@/components/i18n/Text.astro';
---

<section id="acerca" aria-labelledby="about-title">
	<h1 id="about-title">
		<button class="section-toggle" type="button" data-section-toggle aria-expanded="true" aria-controls="about-content">
			<span class="online-dot" aria-hidden="true"></span>
			<Text path="about.title" />
		</button>
	</h1>

	<div id="about-content">
		<p><Text path="about.body" /></p>
	</div>
</section>
